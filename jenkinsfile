pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t shashankshashank123/employee-management:v1 .'
            }
        }

        stage('Test Application') {
            steps {
                  bat 'docker run -d -p 5001:5000 --name employee-test shashankshashank123/employee-management:v1'
        bat 'ping 127.0.0.1 -n 6 > nul'
        bat 'curl http://localhost:5001/health'
        bat 'docker stop employee-test'
        bat 'docker rm employee-test'
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    bat 'docker login -u %DOCKER_USERNAME% -p %DOCKER_PASSWORD%'
                    bat 'docker push shashankshashank123/employee-management:v1'
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                bat 'kubectl apply -f k8s/deployment.yaml'
                bat 'kubectl apply -f k8s/service.yaml'
            }
        }
    }
}